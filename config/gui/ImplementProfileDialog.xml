    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="800px 300px">
        <Text profile="cpProfileDialogTitle" text="$l10n_CP_implementProfiles_dialogTitle" />
        <MultiTextOption profile="cpProfileDialogSelector" id="profileSelector" namedComponents="true" hideButtonOnLimitReached="false" />
