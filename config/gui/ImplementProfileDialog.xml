            <Button profile="buttonOK" text="$l10n_CP_implementProfiles_loadProfile" onClick="onClickLoad" />
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="cpProfileDialogTitle" extends="fs25_settingsSectionHeader">
            <anchor value="0 1" /><pivot value="0 1" /><position value="30px -138px" /><size value="740px 32px" /><textSize value="18px" />
            <textAlignment value="center" />
        </Profile>
        <Profile name="cpProfileDialogSelector" extends="fs25_settingsMultiTextOption">
            <anchor value="0 1" /><pivot value="0 1" /><position value="50px -177px" /><size value="700px 40px" />
        </Profile>
    </GUIProfiles>
</GUI>
